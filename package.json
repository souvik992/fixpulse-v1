{
  "name": "bugtracker",
  "version": "2.0.0",
  "description": "Jira-like bug tracking app – PostgreSQL edition",
  "main": "server.js",
  "scripts": {
    "build:app": "esbuild public/app.js --bundle --platform=browser --format=iife --outfile=public/app.bundle.js --loader:.js=jsx",
    "start": "npm run build:app && node server.js",
    "dev": "nodemon --watch server.js --watch public/app.js --exec \"npm run build:app && node server.js\"",
    "test": "node tests/rbac.test.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker exec -it bugtracker_db psql -U bugtracker -d bugtracker"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "pg": "^8.11.3",
    "razorpay": "^2.9.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "nodemon": "^3.0.1"
  }
}
